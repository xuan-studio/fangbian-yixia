{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fangbian-yixia.local/toilet-record.schema.json",
  "title": "ToiletRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sourceType", "sourceName", "sourceUrl", "sourceRef", "dataStatus",
    "name", "district", "address", "coordinates", "openingHours", "open24h",
    "facility", "crowd", "tags", "rating", "reviewCount", "healthScore",
    "confidence", "description", "comments", "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "sourceType": { "enum": ["public_open_data", "premium_xhs", "user_import"] },
    "sourceName": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": ["string", "null"] },
    "sourceRef": { "type": ["string", "null"] },
    "dataStatus": { "enum": ["verified", "community_report", "pending_verification"] },
    "name": { "type": "string", "minLength": 1 },
    "nameStatus": { "enum": ["source_specific", "source_generic", "generated", "community"] },
    "district": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "openingHours": { "type": ["string", "null"] },
    "open24h": { "type": ["boolean", "null"] },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["squat", "seated", "accessible", "thirdRestroom", "babyCare"],
      "properties": {
        "squat": { "type": ["boolean", "null"] },
        "seated": { "type": ["boolean", "null"] },
        "accessible": { "type": ["boolean", "null"] },
        "thirdRestroom": { "type": ["boolean", "null"] },
        "babyCare": { "type": ["boolean", "null"] }
      }
    },
    "crowd": { "type": ["array", "null"], "items": { "type": "object" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "rating": { "type": ["number", "null"] },
    "reviewCount": { "type": ["number", "null"] },
    "healthScore": { "type": ["number", "null"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "description": { "type": ["string", "null"] },
    "sourceMetadata": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["operator", "level", "indoor", "male", "female", "unisex", "fee", "access", "rawTags"],
      "properties": {
        "operator": { "type": ["string", "null"] },
        "level": { "type": ["string", "null"] },
        "indoor": { "type": ["boolean", "null"] },
        "male": { "type": ["boolean", "null"] },
        "female": { "type": ["boolean", "null"] },
        "unisex": { "type": ["boolean", "null"] },
        "fee": { "type": ["string", "null"] },
        "access": { "type": ["string", "null"] },
        "rawTags": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "author", "content", "createdAt", "source"],
        "properties": {
          "id": { "type": "string" },
          "author": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "string" },
          "source": { "enum": ["session", "imported", "xhs_note", "xhs_aggregate", "mock"] },
          "sourceLabel": { "type": ["string", "null"] },
          "sourceUrl": { "type": ["string", "null"] }
        }
      }
    },
    "updatedAt": { "type": ["string", "null"] }
  }
}
